// =============================================================================
// File    : warehouse_rls.dax
// Purpose : Row-Level Security (RLS) role definitions for the Warehouse
//           Analytics Power BI report.
//
// How to apply in Power BI Desktop:
//   1. Home → Manage Roles → Create / edit each role below
//   2. Select the table and paste the DAX filter expression
//   3. Save, then use "View As Roles" to test
//
// RLS Strategy:
//   - Warehouse managers see only their own warehouse's data
//   - Analysts see all warehouses (no filter)
//   - Executive role sees all warehouses (no filter)
// =============================================================================


// ── Role: WH-001 Northeast ────────────────────────────────────────────────────
// Table: dim_warehouse
// Filter expression:
[warehouse_code] = "WH-001"


// ── Role: WH-002 Southeast ────────────────────────────────────────────────────
// Table: dim_warehouse
// Filter expression:
[warehouse_code] = "WH-002"


// ── Role: WH-003 Midwest ──────────────────────────────────────────────────────
// Table: dim_warehouse
// Filter expression:
[warehouse_code] = "WH-003"


// ── Role: WH-004 Southwest ────────────────────────────────────────────────────
// Table: dim_warehouse
// Filter expression:
[warehouse_code] = "WH-004"


// ── Role: WH-005 West ─────────────────────────────────────────────────────────
// Table: dim_warehouse
// Filter expression:
[warehouse_code] = "WH-005"


// ── Role: Analyst (all warehouses) ───────────────────────────────────────────
// Table: dim_warehouse
// Filter expression (no restriction):
TRUE()


// ── Role: Executive (all warehouses) ─────────────────────────────────────────
// Table: dim_warehouse
// Filter expression (no restriction):
TRUE()


// =============================================================================
// Dynamic RLS (optional alternative) — uses the signed-in user's email
// to look up their warehouse assignment from a security mapping table.
//
// Requires a SecurityMapping table with columns:
//   user_email   VARCHAR
//   warehouse_code VARCHAR
//
// Table: dim_warehouse
// Filter expression (dynamic):
// [warehouse_code] IN
//     CALCULATETABLE(
//         VALUES(SecurityMapping[warehouse_code]),
//         SecurityMapping[user_email] = USERPRINCIPALNAME()
//     )
// =============================================================================
